generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          Int       @id @default(autoincrement())
  description String
  amount      Decimal   @db.Decimal(10, 2)
  type        String
  createdAt   DateTime  @default(now())
  // Nullable only to preserve legacy transactions without assigning them to strangers.
  userId      Int?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Restrict)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([categoryId])
  @@index([userId, type, createdAt])
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  passwordHash   String
  tokenVersion   Int             @default(0)
  createdAt      DateTime        @default(now())
  transactions   Transaction[]
  categories     Category[]
  role           UserRole        @default(USER)
  active         Boolean         @default(true)
  spendingLimits SpendingLimit[]
  activities     Activity[]
}

model Category {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(80)
  normalizedName String        @db.VarChar(80)
  userId         Int
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  spendingLimits SpendingLimit[]

  @@unique([userId, normalizedName])
  @@unique([id, userId])
}

enum UserRole {
  USER
  ADMIN
}

enum ActivityAction {
  TRANSACTION_CREATED
  TRANSACTION_UPDATED
  TRANSACTION_DELETED
  CATEGORY_CREATED
  ACCOUNT_ACTIVATED
  ACCOUNT_DEACTIVATED
}

model SpendingLimit {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Cascade)
  month      Int
  year       Int
  amount     Decimal  @db.Decimal(10, 2)

  @@unique([userId, categoryId, year, month])
}

model Activity {
  id             Int            @id @default(autoincrement())
  // Keep a numeric reference when the related account is permanently deleted.
  actorId        Int
  actorAccountId Int?
  actor          User?          @relation(fields: [actorAccountId], references: [id], onDelete: SetNull)
  action         ActivityAction
  recordId       Int
  createdAt      DateTime       @default(now())

  @@index([actorAccountId])
  @@index([createdAt, id])
}
